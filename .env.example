# Kopieer naar .env.local en vul in. .env.local wordt NOOIT gecommit.
# Daarna: powershell -ExecutionPolicy Bypass -File scripts/set-github-secrets.ps1

# Supabase > Account (rechtsboven) > Access Tokens > Generate new token
SUPABASE_ACCESS_TOKEN=
# Het database-wachtwoord dat je koos bij het aanmaken van het project
SUPABASE_DB_PASSWORD=
# Het stukje uit de URL: https://<DIT>.supabase.co
SUPABASE_PROJECT_REF=
# Project Settings > API Keys > secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Het wachtwoord waarmee Jacky, Paps en Bren inloggen in de app
TRIAGEVE_TEAM_PASSWORD=
# Fase 12: npx web-push generate-vapid-keys  (privé NOOIT in git)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Fase 14: kies zelf een sterke zin, bewaar in je wachtwoordmanager. Nooit in git.
BACKUP_PASSPHRASE=
